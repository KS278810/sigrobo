 "caveats": [
  {
   "code": "tuned_by_authors",
   "ja": "公開値は、論文の作者が調整したモデルのシミュレーション RMSE。ここのモデルは出荷時の設定で、窓の長さも 1 つに固定している。",
   "en": "Published values are the simulation RMSE of models tuned by the authors of the paper. The models here run with the shipped settings and one fixed window length."
  },
  {
   "code": "window",
   "ja": "窓の長さは、各ベンチマークが試験の先頭で状態の初期化に使ってよいとする長さにそろえた。そのため、評価する行は論文と同じ。",
   "en": "The window length is the length that the benchmark allows for initialising the state at the start of a test set, so the rows scored are the same as in the paper."
  },
  {
   "code": "gp_narx",
   "ja": "論文の GP NARX は、学習データの先頭 1000 点までで学習している。",
   "en": "The GP NARX of the paper was trained on at most the first 1000 training points."
  },
  {
   "code": "table4",
   "ja": "論文の表 4 の最先端の値は、一部のベンチマークにしか無い。",
   "en": "Table 4 of the paper lists selected state of the art values only for some benchmarks."
  },
  {
   "code": "rnn_row",
   "ja": "公開の RNN の行に当たるモデルは無い。再帰型のモデルは gru と lstm。",
   "en": "The published RNN row has no counterpart here: the recurrent models are gru and lstm."
  },
  {
   "code": "seeds",
   "ja": "乱数は 1 つだけで走らせる。",
   "en": "A single random start is used."
  }
 ],
