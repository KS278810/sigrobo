 "caveats": [
  {
   "code": "tuned_by_authors",
   "ja": "公開値は、アーカイブの作者が設定した 13 の手法の 5 回の平均。ここのモデルは出荷時の設定で、乱数は 1 つだけで走らせた。",
   "en": "Published values are the mean of 5 runs of 13 methods configured by the authors of the archive. The models here run with the shipped settings and a single random start."
  },
  {
   "code": "archive_version",
   "ja": "aeon が配る版は、論文の表 1 より数件少ないデータセットがあり、試験データは完全には同じでない。",
   "en": "The aeon copy of the archive has a few instances fewer than Table 1 of the paper for some datasets, so the test sets are not identical."
  },
  {
   "code": "rounding",
   "ja": "公開値は小数 2 桁に丸めて印刷されているので、自分の値も 2 桁に丸めてから並べた。",
   "en": "Published values are printed with 2 decimals, so the value of this tool is rounded to 2 decimals before it is placed among them."
  },
  {
   "code": "missing",
   "ja": "欠損のあるデータは、系列内で前方補完してから走らせた。補完しても残る欠損を受け付けないモデルは走らせていない。",
   "en": "Missing values are filled forward inside each series before the run. A model that cannot take the missing values that remain is not run."
  },
  {
   "code": "slow",
   "ja": "rocket は値が 2000 万個以下かつ系列が 5 万本以下、drcif は値が 100 万個以下のデータだけで走らせた。遅いことと、rocket の特徴量が系列数に比例してメモリを使うため。",
   "en": "rocket is run only where the data has at most 20 million values and at most 50 thousand series, and drcif at most 1 million values, because they are slow and the features of rocket take memory in proportion to the number of series."
  },
  {
   "code": "australia",
   "ja": "AustraliaRainfall は、系列が 16 万本ある。rocket と drcif は上限で除き、minirocket は系列が 10 万本を超えるので除いた。dummy と summary_lightgbm は走らせた。",
   "en": "AustraliaRainfall has 160 thousand series. rocket and drcif are excluded by their limits, and minirocket because it has more than 100 thousand series. dummy and summary_lightgbm are run."
  },
  {
   "code": "ppgdalia",
   "ja": "PPGDalia は、チャネルごとに系列の長さが違うので除いた。",
   "en": "PPGDalia is left out because its series have different lengths in different channels."
  }
 ],
